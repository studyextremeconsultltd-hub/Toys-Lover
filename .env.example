# Public site URL (used for Stripe/PayPal return links)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Labels shown on the Pay Now UI
NEXT_PUBLIC_STRIPE_ACCOUNT_LABEL=Toy Bloom · Stripe
NEXT_PUBLIC_PAYPAL_ACCOUNT_LABEL=Toy Bloom · PayPal

# Stripe — preferred: secret key creates a live Checkout Session
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
# Fallback: static Payment Link if no secret key
STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_link

# PayPal — preferred: REST credentials create an order + approve URL
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
# Fallback: PayPal.Me link (amount is appended)
PAYPAL_ME_LINK=https://www.paypal.com/paypalme/youraccount
